# ==========================================
# 1. IMPORT LIBRARIES
# ==========================================
import os
import re
import string
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
import nltk

from nltk.corpus import stopwords
from nltk.stem import WordNetLemmatizer

from sklearn.feature_extraction.text import TfidfVectorizer
from sklearn.linear_model import LogisticRegression
from sklearn.naive_bayes import MultinomialNB
from sklearn.svm import LinearSVC
from sklearn.preprocessing import LabelEncoder
from sklearn.model_selection import train_test_split
from sklearn.metrics import (
    accuracy_score,
    classification_report,
    confusion_matrix
)

nltk.download("stopwords")
nltk.download("wordnet")


# ==========================================
# 2. LOAD DATASET
# ==========================================
folder_path = r"C:\Users\ajayd\Desktop\Anaconda\Genre Classification Dataset"

train_path = os.path.join(folder_path, "train_data.txt")
test_path = os.path.join(folder_path, "test_data.txt")
solution_path = os.path.join(folder_path, "test_data_solution.txt")

# Training file: ID, TITLE, GENRE, DESCRIPTION
train_df = pd.read_csv(
    train_path,
    sep=r"\s*:::\s*",
    engine="python",
    names=["ID", "TITLE", "GENRE", "DESCRIPTION"],
    header=None,
    dtype=str
)

# Test file: ID, TITLE, DESCRIPTION
test_df = pd.read_csv(
    test_path,
    sep=r"\s*:::\s*",
    engine="python",
    names=["ID", "TITLE", "DESCRIPTION"],
    header=None,
    dtype=str
)

print("Training dataset shape:", train_df.shape)
print("Test dataset shape:", test_df.shape)
print(train_df.head())

# Remove incomplete training records
train_df = train_df.dropna(
    subset=["GENRE", "DESCRIPTION"]
).copy()

train_df["GENRE"] = train_df["GENRE"].str.strip()
train_df["DESCRIPTION"] = train_df["DESCRIPTION"].str.strip()

# ==========================================
# 3. TEXT PREPROCESSING
# ==========================================
stop_words = set(stopwords.words("english"))
lemmatizer = WordNetLemmatizer()

def preprocess_text(text):
    text = str(text).lower()

    # Remove URLs
    text = re.sub(r"https?://\S+|www\.\S+", "", text)

    # Remove digits
    text = re.sub(r"\d+", "", text)

    # Remove punctuation
    text = text.translate(
        str.maketrans("", "", string.punctuation)
    )

    # Remove stopwords and apply lemmatization
    tokens = text.split()

    cleaned_tokens = [
        lemmatizer.lemmatize(word)
        for word in tokens
        if word not in stop_words
    ]

    return " ".join(cleaned_tokens)


print("Preprocessing text...")

train_df["CLEANED_DESCRIPTION"] = (
    train_df["DESCRIPTION"].apply(preprocess_text)
)

test_df = test_df.dropna(subset=["DESCRIPTION"]).copy()

test_df["CLEANED_DESCRIPTION"] = (
    test_df["DESCRIPTION"].apply(preprocess_text)
)

print("Text preprocessing completed.")
# ==========================================
# 4. FEATURE EXTRACTION AND SPLIT
# ==========================================
X_text = train_df["CLEANED_DESCRIPTION"]
y = train_df["GENRE"]

encoder = LabelEncoder()
y_encoded = encoder.fit_transform(y)

# Split text before fitting TF-IDF to avoid data leakage
X_train_text, X_val_text, y_train, y_val = train_test_split(
    X_text,
    y_encoded,
    test_size=0.2,
    random_state=42,
    stratify=y_encoded
)

tfidf = TfidfVectorizer(
    max_features=10000,
    ngram_range=(1, 2)
)

X_train = tfidf.fit_transform(X_train_text)
X_val = tfidf.transform(X_val_text)

print("Training features:", X_train.shape)
print("Validation features:", X_val.shape)

==================================
# 5. MODEL TRAINING AND EVALUATION
# ==========================================
models = {
    "Naive Bayes": MultinomialNB(),
    "Logistic Regression": LogisticRegression(max_iter=1000),
    "Linear SVM": LinearSVC()
}

trained_models = {}
results = {}

for name, model in models.items():
    print(f"\n--- Training {name} ---")

    model.fit(X_train, y_train)
    y_pred = model.predict(X_val)

    accuracy = accuracy_score(y_val, y_pred)

    trained_models[name] = model
    results[name] = accuracy

    print(f"Accuracy: {accuracy:.4f}")

    print(
        classification_report(
            y_val,
            y_pred,
            labels=np.arange(len(encoder.classes_)),
            target_names=encoder.classes_,
            zero_division=0
        )
    )

# Compare models
print("\n--- Model Comparison ---")

for name, accuracy in results.items():
    print(f"{name}: {accuracy:.4f}")

best_model_name = max(results, key=results.get)
print("\nBest model:", best_model_name)

best_model = trained_models[best_model_name]




# ==========================================
# 6. CONFUSION MATRIX
# ==========================================
y_pred_best = best_model.predict(X_val)

cm = confusion_matrix(
    y_val,
    y_pred_best,
    labels=np.arange(len(encoder.classes_))
)

plt.figure(figsize=(14, 10))

sns.heatmap(
    cm,
    cmap="Blues",
    xticklabels=encoder.classes_,
    yticklabels=encoder.classes_
)

plt.title(f"Confusion Matrix - {best_model_name}")
plt.xlabel("Predicted Genre")
plt.ylabel("Actual Genre")
plt.xticks(rotation=90)
plt.yticks(rotation=0)
plt.tight_layout()
plt.show()

# ==========================================
# 7. PREDICT GENRES FOR TEST DATA
# ==========================================
X_test = tfidf.transform(test_df["CLEANED_DESCRIPTION"])

test_predictions = best_model.predict(X_test)

test_df["PREDICTED_GENRE"] = encoder.inverse_transform(
    test_predictions
)

print("\n--- Test Dataset Predictions ---")
print(test_df[["ID", "TITLE", "PREDICTED_GENRE"]].head(10))

# Save predictions
output_path = os.path.join(folder_path, "genre_predictions.csv")

test_df[["ID", "TITLE", "PREDICTED_GENRE"]].to_csv(
    output_path,
    index=False
)

print("\nPredictions saved to:", output_path)


# ==========================================
# 8. CUSTOM MOVIE GENRE PREDICTION
# ==========================================
def predict_movie_genre(plot_summary):
    cleaned_plot = preprocess_text(plot_summary)
    vectorized_plot = tfidf.transform([cleaned_plot])

    prediction = best_model.predict(vectorized_plot)

    return encoder.inverse_transform(prediction)[0]


sample_plots = [
    "Astronauts travel through a wormhole to save humanity.",
    "A young couple falls in love during a tragic voyage.",
    "A detective tries to catch a criminal mastermind."
]

print("\n--- Custom Predictions ---")

for plot in sample_plots:
    print("Plot:", plot)
    print("Predicted Genre:", predict_movie_genre(plot))
    print()
